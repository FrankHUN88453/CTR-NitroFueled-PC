// Application icon and version info for CrashTeamRacingNitroFueled.exe
#include <windows.h>

1 ICON "app.ico"

// Release builds (CTR_EMBED_DATA=OFF) carry nothing of the games: tools/setup_shaders.py makes both
// files from the player's own installs, next to eboot.bin.
#ifndef CTR_NO_EMBED
// translated shaders (tools/pack_shaders.py, generated by build.bat)
SHADERS RCDATA "shaders.bin"

// Xbox button glyphs in the layout of the game's button atlas (tools/make_glyph_atlas.py, made by
// build.bat from the Crash Bandicoot N. Sane Trilogy PC files; empty when those are not installed)
GLYPHS_XBOX RCDATA "glyphs_xbox.rgba"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Crash Team Racing Nitro-Fueled (native PC host)"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "CrashTeamRacingNitroFueled"
            VALUE "OriginalFilename", "CrashTeamRacingNitroFueled.exe"
            VALUE "ProductName", "Crash Team Racing Nitro-Fueled"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
