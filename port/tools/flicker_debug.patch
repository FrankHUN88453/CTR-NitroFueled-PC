+void TakeSnap(u64 base, bool depth, const char* why) {
+    if (!g_snaps) g_snaps = new SnapFrame[kSnapFrames];
+    SnapFrame& f = g_snaps[g_frame % kSnapFrames];
+    if (f.frame != g_frame) f.frame = g_frame, f.n = 0;
+    if (f.n >= kSnapMax) return;
+    auto it = g_surfaces.find(base);
+    if (it == g_surfaces.end() || !it->second.srv || !g_blit_vs) return;
+    Snap& sn = f.s[f.n];
+    if (!sn.tex) {
+        D3D11_TEXTURE2D_DESC td{};
+        td.Width = kSnapW, td.Height = kSnapH, td.MipLevels = td.ArraySize = 1;
+        td.Format = DXGI_FORMAT_R8G8B8A8_UNORM, td.SampleDesc.Count = 1;
+        td.BindFlags = D3D11_BIND_RENDER_TARGET;
+        if (FAILED(g_dev->CreateTexture2D(&td, nullptr, &sn.tex))) return;
+        g_dev->CreateRenderTargetView(sn.tex.Get(), nullptr, &sn.rtv);
+    }
+    snprintf(sn.label, sizeof(sn.label), "%03d_%s_%llx_%s", f.n, depth ? "z" : "c", (unsigned long long)base, why);
+    f.n++;
+    ID3D11ShaderResourceView* none[32] = {};
+    g_ctx->PSSetShaderResources(0, 32, none);
+    g_ctx->OMSetRenderTargets(1, sn.rtv.GetAddressOf(), nullptr);
+    D3D11_VIEWPORT v{0, 0, (float)kSnapW, (float)kSnapH, 0, 1};
+    g_ctx->RSSetViewports(1, &v);
+    g_ctx->RSSetState(GetRaster(0, false));
+    g_ctx->OMSetDepthStencilState(g_depth_off.Get(), 0);
+    g_ctx->OMSetBlendState(nullptr, nullptr, 0xFFFFFFFF);
+    g_ctx->IASetInputLayout(nullptr);
+    g_ctx->GSSetShader(nullptr, nullptr, 0);
+    g_ctx->IASetPrimitiveTopology(D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    g_ctx->VSSetShader(g_blit_vs.Get(), nullptr, 0);
+    g_ctx->PSSetShader(g_blit_ps.Get(), nullptr, 0);
+    g_ctx->PSSetShaderResources(0, 1, it->second.srv.GetAddressOf());
+    g_ctx->PSSetSamplers(0, 1, g_samp_linear.GetAddressOf());
+    g_ctx->Draw(3, 0);
+    g_ctx->PSSetShaderResources(0, 32, none);
+}
+
+// before a draw: snapshot the targets the previous draws rendered into when they change
+void SnapTargets(u64 rt, u64 z, const char* what) {
+    if (rt != g_snap_rt && g_snap_rt) TakeSnap(g_snap_rt, false, g_snap_last);
+    if (z != g_snap_z && g_snap_z) TakeSnap(g_snap_z, true, g_snap_last);
+    g_snap_rt = rt, g_snap_z = z;
+    snprintf(g_snap_last, sizeof(g_snap_last), "%s", what);
+}
+
+void SaveSnaps(const fs::path& dir, u64 frame) {
+    if (!g_snaps) return;
+    SnapFrame& f = g_snaps[frame % kSnapFrames];
+    if (f.frame != frame) return;
+    D3D11_TEXTURE2D_DESC td{};
+    td.Width = kSnapW, td.Height = kSnapH, td.MipLevels = td.ArraySize = 1;
+    td.Format = DXGI_FORMAT_R8G8B8A8_UNORM, td.SampleDesc.Count = 1;
+    td.Usage = D3D11_USAGE_STAGING, td.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    ComPtr<ID3D11Texture2D> st;
+    if (FAILED(g_dev->CreateTexture2D(&td, nullptr, &st))) return;
+    for (int i = 0; i < f.n; i++) {
+        g_ctx->CopyResource(st.Get(), f.s[i].tex.Get());
+        D3D11_MAPPED_SUBRESOURCE m;
+        if (SUCCEEDED(g_ctx->Map(st.Get(), 0, D3D11_MAP_READ, 0, &m))) {
+            std::string name = "snap_" + std::to_string(frame) + "_" + f.s[i].label;
+            for (char& c : name)
+                if (!isalnum((unsigned char)c) && c != '_' && c != '-') c = '_';
+            WriteBmp((dir / (name.substr(0, 150) + ".bmp")).string().c_str(), (const u8*)m.pData, kSnapW, kSnapH,
+                     m.RowPitch, false);
+            g_ctx->Unmap(st.Get(), 0);
+        }
+    }
+}
