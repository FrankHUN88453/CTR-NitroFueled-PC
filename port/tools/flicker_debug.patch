+// quick data identity for the trap: 8-byte words, every 8th word of large ranges
+u32 TrapHash(const void* p, size_t n) {
+    const u8* b = (const u8*)p;
+    u64 h = 0xcbf29ce484222325ull ^ n;
+    const size_t words = n / 8, step = n > 65536 ? 8 : 1;
+    for (size_t i = 0; i < words; i += step) {
+        u64 w;
+        memcpy(&w, b + i * 8, 8);
+        h = (h ^ w) * 0x100000001b3ull;
+        h ^= h >> 29;
+    }
+    for (size_t i = words * 8; i < n; i++) h = (h ^ b[i]) * 0x100000001b3ull;
+    return (u32)(h ^ (h >> 32));
+}
